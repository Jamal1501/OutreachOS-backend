APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173
APP_API_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

OBSERVABILITY_SERVICE_NAME=social-core-api
OBSERVABILITY_ALERTS_ENABLED=false
OBSERVABILITY_ALERT_WEBHOOK_URL=
OBSERVABILITY_ERROR_TRACKING_ENABLED=false
OBSERVABILITY_ERROR_WEBHOOK_URL=
OBSERVABILITY_FAILED_JOBS_WINDOW_MINUTES=15
OBSERVABILITY_FAILED_JOBS_THRESHOLD=0
OBSERVABILITY_FAILED_WEBHOOKS_WINDOW_MINUTES=60
OBSERVABILITY_FAILED_WEBHOOKS_THRESHOLD=0
OBSERVABILITY_MAX_PENDING_JOBS=500

SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_CSP_REPORT_URI=/api/csp-report
SECURITY_CSP_CONNECT_SRC="'self',https://*.supabase.co,https://loveframes-outreach-api-1.onrender.com,https://*.onrender.com"
SECURITY_CSP_IMG_SRC="'self',data:,blob:,https:"
SECURITY_CSP_STYLE_SRC="'self','unsafe-inline',https://fonts.googleapis.com"
SECURITY_CSP_FONT_SRC="'self',data:,https://fonts.gstatic.com"

DB_CONNECTION=sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
